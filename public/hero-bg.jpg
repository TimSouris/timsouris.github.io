<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" width="1920" height="1080">
  <defs>
    <radialGradient id="grad-center" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#1e3a8a" stop-opacity="0.35"/>
      <stop offset="60%" stop-color="#0b132b" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#060913" stop-opacity="1"/>
    </radialGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(56, 189, 248, 0.05)" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="1920" height="1080" fill="#060913"/>
  <rect width="1920" height="1080" fill="url(#grad-center)"/>
  <rect width="1920" height="1080" fill="url(#grid)"/>
  <circle cx="960" cy="420" r="380" fill="none" stroke="rgba(56, 189, 248, 0.08)" stroke-width="1" stroke-dasharray="6 6"/>
  <circle cx="960" cy="420" r="540" fill="none" stroke="rgba(37, 99, 235, 0.06)" stroke-width="1"/>
</svg>
