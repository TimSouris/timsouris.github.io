---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Timothée Souris — Cybersecurity Engineer & Full-Stack Developer"
  description="Professional portfolio of Timothée Souris: Offensive Security (Web Pentest), SOC/SIEM Detection (Splunk), Risk Assessment (EBIOS RM) and full-stack software engineering."
  lang="en"
>
  <main id="top">

    <!-- 16:9 Impactful & Uncluttered Hero Section -->
    <section class="container hero-container">
      <div class="hero-stage">
        <div class="hero-overlay"></div>
        <div class="hero-content">
          <div class="hero-kicker">
            <span class="status-dot"></span>
            Software Engineering &bull; Operational Cybersecurity
          </div>

          <h1 class="hero-title">
            Building resilient systems.<br />
            Hunting vulnerabilities.<br />
            <span class="hero-accent">Securing critical flows.</span>
          </h1>

          <p class="hero-sub">
            Timothée Souris &bull; Cybersecurity Engineer &amp; Full-Stack Developer
          </p>

          <!-- Exactly 2 buttons under the title -->
          <div class="hero-actions">
            <a href="#presentation" class="btn btn-primary btn-lg">
              Learn More
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
            </a>
            <a href="#contact" class="btn btn-ghost btn-lg">
              Contact
            </a>
          </div>
        </div>

        <!-- Hint for 16:9 image -->
        <div class="hero-img-badge">
          <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          16:9 Background (replace /public/hero-bg.jpg)
        </div>
      </div>
    </section>

    <!-- Presentation & Profile Section -->
    <section id="presentation" class="container section-gap">
      <div class="profile-card">
        <div class="profile-grid">
          <div class="profile-left">
            <div class="photo-frame">
              <div class="photo-placeholder">
                <svg width="44" height="44" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                <span>Pro Portrait</span>
              </div>
            </div>
            <div class="availability-pill">
              <span class="status-dot"></span>
              Open to opportunities
            </div>
          </div>

          <div class="profile-body">
            <div class="section-eyebrow">Profile &amp; Focus</div>
            <h2 class="profile-name">Timothée Souris</h2>
            <p class="profile-lead">
              Holding a <strong>Master's degree in Computer Science (Bac+5)</strong> backed by hands-on full-stack development apprenticeship, I specialize in addressing critical cybersecurity challenges: <strong>offensive web application auditing</strong> (Global Top 3% on TryHackMe), <strong>SOC/SIEM intrusion detection (Splunk)</strong>, and <strong>risk management using ANSSI EBIOS RM</strong>.
            </p>

            <div class="profile-meta-tags">
              <span class="meta-tag">M.S. in Computer Science</span>
              <span class="meta-tag">TryHackMe Top 3%</span>
              <span class="meta-tag">YesWeHack Researcher</span>
              <span class="meta-tag">ANSSI EBIOS RM</span>
              <span class="meta-tag">CompTIA Security+</span>
              <span class="meta-tag">Google Cybersecurity</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Key Metrics Strip -->
    <section class="container section-gap">
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-val">Bac+5 <span class="unit">M.S.</span></div>
          <div class="metric-label">Master's in Computer Science</div>
          <div class="metric-sub">Rigorous foundation in software engineering & architecture</div>
        </div>
        <div class="metric-card">
          <div class="metric-val">Top 3<span class="unit">%</span></div>
          <div class="metric-label">TryHackMe Worldwide</div>
          <div class="metric-sub">Continuous hands-on offensive practice & CTF box solving</div>
        </div>
        <div class="metric-card">
          <div class="metric-val">3<span class="unit">x</span></div>
          <div class="metric-label">Key Certifications</div>
          <div class="metric-sub">ANSSI EBIOS RM, CompTIA Security+, Google Cyber</div>
        </div>
        <div class="metric-card">
          <div class="metric-val">0<span class="unit">d</span></div>
          <div class="metric-label">Security by Design</div>
          <div class="metric-sub">Proactive posture: minimizing the attack surface from day one</div>
        </div>
      </div>
    </section>

    <!-- Services (Bento Grid) -->
    <section id="services" class="container section-gap">
      <div class="section-head">
        <div class="section-eyebrow">Service Offerings</div>
        <h2 class="section-title">Technical Capabilities &amp; Services</h2>
        <p class="section-desc">Targeted engagements bridging methodology, offensive problem solving, and rigorous software development.</p>
      </div>

      <div class="services-bento">
        <!-- Service 1: Pentest Web -->
        <div class="service-card featured-wide">
          <div>
            <span class="service-badge">Offensive Security</span>
            <h3 class="service-title">Web Application &amp; API Pentesting</h3>
            <p class="service-desc">
              Real-world assessments driven by OWASP methodologies and business logic flaws. Uncovering high-impact vulnerabilities (IDORs, authorization bypasses, injections, SSRFs, broken authentication) accompanied by clear remediation steps for engineering teams.
            </p>
          </div>
          <div class="service-tags">
            <span class="tag-pill">OWASP Top 10</span>
            <span class="tag-pill">Burp Suite Pro</span>
            <span class="tag-pill">REST &amp; GraphQL APIs</span>
            <span class="tag-pill">PoCs &amp; Remediation</span>
          </div>
        </div>

        <!-- Service 2: SOC Splunk -->
        <div class="service-card">
          <div>
            <span class="service-badge">Blue Team &amp; SOC</span>
            <h3 class="service-title">SOC Monitoring &amp; Splunk Detection</h3>
            <p class="service-desc">
              Building and fine-tuning behavioral detection rules, triaging high-fidelity alerts, and conducting threat hunting across network and identity telemetry.
            </p>
          </div>
          <div class="service-tags">
            <span class="tag-pill">Splunk SIEM</span>
            <span class="tag-pill">Threat Hunting</span>
            <span class="tag-pill">SPL &amp; Dashboards</span>
          </div>
        </div>

        <!-- Service 3: EBIOS RM -->
        <div class="service-card">
          <div>
            <span class="service-badge">Governance &amp; Risk</span>
            <h3 class="service-title">EBIOS RM Risk Assessments</h3>
            <p class="service-desc">
              Threat landscape modeling and attack scenario construction compliant with the official French ANSSI methodology to guide strategic security investments.
            </p>
          </div>
          <div class="service-tags">
            <span class="tag-pill">ANSSI Certified</span>
            <span class="tag-pill">Strategic Scenarios</span>
            <span class="tag-pill">Risk Treatment Plans</span>
          </div>
        </div>

        <!-- Service 4: Security by Design -->
        <div class="service-card">
          <div>
            <span class="service-badge">Web Engineering</span>
            <h3 class="service-title">Security by Design Web Architecture</h3>
            <p class="service-desc">
              Building lightweight, lightning-fast static and JAMstack platforms without unnecessary server-side attack surface, strictly adhering to modern hardening standards.
            </p>
          </div>
          <div class="service-tags">
            <span class="tag-pill">Jamstack / SSG</span>
            <span class="tag-pill">CSP / HSTS Hardening</span>
            <span class="tag-pill">&lt; 100ms Load Time</span>
          </div>
        </div>

        <!-- Service 5: AI & Tooling -->
        <div class="service-card">
          <div>
            <span class="service-badge">Tooling &amp; AI</span>
            <h3 class="service-title">Custom Scripting &amp; AI Automation</h3>
            <p class="service-desc">
              Automating time-consuming security tasks, offensive reconnaissance pipelines (Python, Go, Bash), and integrating tailored autonomous AI agents.
            </p>
          </div>
          <div class="service-tags">
            <span class="tag-pill">Python</span>
            <span class="tag-pill">Go</span>
            <span class="tag-pill">Bash</span>
            <span class="tag-pill">AI Agents</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Technical Pillars -->
    <section id="competences" class="container section-gap">
      <div class="section-head">
        <div class="section-eyebrow">Technical Stack</div>
        <h2 class="section-title">Core Skills &amp; Environments</h2>
        <p class="section-desc">A complementary balance between software craftsmanship and rigorous systems hardening.</p>
      </div>

      <div class="pillars-grid">
        <div class="pillar-card">
          <div class="pillar-icon">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          </div>
          <h3 class="pillar-title">Defensive / SOC</h3>
          <ul class="pillar-items">
            <li>Splunk (SPL, Dashboards, Alerting)</li>
            <li>Threat Hunting & alert triage</li>
            <li>Incident handling & forensic triage</li>
            <li>System & network log analysis</li>
          </ul>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="pillar-title">Offensive / Audit</h3>
          <ul class="pillar-items">
            <li>Burp Suite Professional</li>
            <li>OWASP Top 10 methodology</li>
            <li>Attack surface mapping & recon</li>
            <li>Web application & API vulnerability testing</li>
          </ul>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          </div>
          <h3 class="pillar-title">Software Engineering</h3>
          <ul class="pillar-items">
            <li>Python, Go, advanced Bash</li>
            <li>JavaScript, TypeScript, React</li>
            <li>RESTful architectures & APIs</li>
            <li>Git, Docker, GitHub Actions CI/CD</li>
          </ul>
        </div>

        <div class="pillar-card">
          <div class="pillar-icon">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <h3 class="pillar-title">Risk &amp; Governance</h3>
          <ul class="pillar-items">
            <li>EBIOS RM (ANSSI Certified)</li>
            <li>CompTIA Security+</li>
            <li>Unwanted event modeling</li>
            <li>Business impact vs technical risk triage</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Write-ups & Research -->
    <section id="publications" class="container section-gap">
      <div class="section-head" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px;">
        <div>
          <div class="section-eyebrow">Publications &amp; Field Notes</div>
          <h2 class="section-title">CTF Write-ups &amp; Security Research</h2>
          <p class="section-desc">Documented technical methodologies, PoC walk-throughs, and detection tradecraft.</p>
        </div>
        <a href="#contact" class="btn btn-ghost btn-sm">All articles &rarr;</a>
      </div>

      <div class="writeups-grid">
        <article class="writeup-card">
          <div class="writeup-meta">
            <span class="thm-badge thm-hard">Hard • TryHackMe</span>
            <span class="writeup-date">Sept 2026</span>
          </div>
          <h3 class="writeup-title">WAF Bypass &amp; Chained SSRF targeting an internal endpoint</h3>
          <p class="writeup-snippet">
            Complete walk-through analyzing an application proxy, abusing URL encoding normalization flaws, and pivoting to extract cloud metadata.
          </p>
          <span class="writeup-link">Read write-up &rarr;</span>
        </article>

        <article class="writeup-card">
          <div class="writeup-meta">
            <span class="thm-badge thm-medium">Medium • SOC / SIEM</span>
            <span class="writeup-date">Aug 2026</span>
          </div>
          <h3 class="writeup-title">Authoring SPL detection rules for distributed password spraying</h3>
          <p class="writeup-snippet">
            Building resilient time-windowed Splunk queries to flag distributed brute-force attempts while preventing benign user lockouts.
          </p>
          <span class="writeup-link">Read write-up &rarr;</span>
        </article>

        <article class="writeup-card">
          <div class="writeup-meta">
            <span class="thm-badge thm-research">Methodology • EBIOS RM</span>
            <span class="writeup-date">July 2026</span>
          </div>
          <h3 class="writeup-title">Tailoring EBIOS RM for agile scale-up cloud infrastructures</h3>
          <p class="writeup-snippet">
            Practical roadmap conducting the 5 EBIOS RM workshops in fast-moving engineering teams without slowing down development cadences.
          </p>
          <span class="writeup-link">Read write-up &rarr;</span>
        </article>
      </div>
    </section>

    <!-- Career Timeline -->
    <section id="parcours" class="container section-gap">
      <div class="section-head">
        <div class="section-eyebrow">Career Timeline</div>
        <h2 class="section-title">Experience &amp; Academic Background</h2>
      </div>

      <div class="timeline">
        <div class="timeline-item">
          <div class="timeline-date">2024 &mdash; 2026</div>
          <div class="timeline-role">Software Engineer &amp; Cybersecurity Associate (Apprenticeship)</div>
          <div class="timeline-org">Enterprise Environment • Paris, France</div>
          <p class="timeline-desc">
            Full-stack engineering on internal production platforms, integrating automated security gates, triaging vulnerabilities, and championing secure coding guidelines.
          </p>
        </div>

        <div class="timeline-item">
          <div class="timeline-date">2021 &mdash; 2026</div>
          <div class="timeline-role">Master's Degree in Computer Science (Bac+5)</div>
          <div class="timeline-org">Higher University Curriculum • Software Engineering &amp; Networks</div>
          <p class="timeline-desc">
            Deep focus on distributed architectures, network protocol security, applied cryptography, and formal risk assessment methodologies.
          </p>
        </div>

        <div class="timeline-item">
          <div class="timeline-date">Continuous</div>
          <div class="timeline-role">Offensive Mastery &amp; CTF Challenges</div>
          <div class="timeline-org">TryHackMe (Global Top 3%) &amp; YesWeHack Bug Hunting</div>
          <p class="timeline-desc">
            Continuous testing on vulnerable targets (Active Directory domains, Linux privilege escalation, Web exploits), authoring PoCs, and participating in authorized bounty programs.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="container section-gap">
      <div class="contact-cta">
        <div class="section-eyebrow" style="justify-content: center; margin-bottom: 12px;">Direct Contact</div>
        <h2 class="contact-title">Let's Build Something Resilient</h2>
        <p class="contact-desc">
          Whether you need a <strong>cybersecurity engineer to reinforce your SOC operations</strong>, a <strong>pentester to audit your web applications</strong>, or a hybrid dev/security profile, reach out directly.
        </p>

        <div class="contact-channels">
          <a href="mailto:timotheesouris@icloud.com" class="btn btn-primary btn-lg">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            timotheesouris@icloud.com
          </a>
          <a href="https://linkedin.com/in/timothee-souris" target="_blank" rel="noopener" class="btn btn-ghost btn-lg">
            LinkedIn
          </a>
          <a href="https://github.com/TimSouris" target="_blank" rel="noopener" class="btn btn-ghost btn-lg">
            GitHub @TimSouris
          </a>
          <a href="https://tryhackme.com" target="_blank" rel="noopener" class="btn btn-ghost btn-lg">
            TryHackMe
          </a>
        </div>

        <div class="pgp-wrapper">
          <span class="pgp-pill">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            Public PGP key available upon request
          </span>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  .section-gap {
    margin-bottom: 96px;
  }

  /* 16:9 Hero Container & Stage */
  .hero-container {
    padding-top: 24px;
    margin-bottom: 72px;
  }

  .hero-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 520px;
    max-height: 780px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background-color: #070c18;
    background-image:
      linear-gradient(180deg, rgba(6, 9, 19, 0.45) 0%, rgba(6, 9, 19, 0.85) 65%, var(--bg-base) 100%),
      url('/hero-bg.jpg'),
      url('/hero-bg.svg');
    background-size: cover;
    background-position: center;
    box-shadow: 0 20px 50px -15px rgba(0,0,0,0.7);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(37, 99, 235, 0.12), transparent 70%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 860px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--accent-primary);
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    margin-bottom: 24px;
  }

  .hero-title {
    font-size: clamp(2.3rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--text-primary);
    margin-bottom: 20px;
  }

  .hero-accent {
    background: linear-gradient(135deg, #ffffff 30%, var(--accent-primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-sub {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 34px;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hero-img-badge {
    position: absolute;
    bottom: 14px;
    right: 18px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    background: rgba(6, 9, 19, 0.7);
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-emerald);
    box-shadow: 0 0 8px var(--accent-emerald);
    animation: pulse-dot 2s infinite ease-in-out;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  /* Profile Card */
  .profile-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 40px;
    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5);
  }

  .profile-grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 48px;
    align-items: center;
  }

  .profile-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .photo-frame {
    width: 180px;
    height: 180px;
    border-radius: var(--radius-md);
    background: var(--bg-surface-elevated);
    border: 2px solid var(--border-accent);
    box-shadow: 0 0 30px rgba(56, 189, 248, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .photo-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--accent-primary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .availability-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    font-size: 0.76rem;
    font-family: var(--font-mono);
    color: #34d399;
  }

  .profile-name {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-bottom: 12px;
  }

  .profile-lead {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 24px;
  }

  .profile-lead strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .profile-meta-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .meta-tag {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    padding: 4px 10px;
    border-radius: 4px;
    color: #cbd5e1;
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

